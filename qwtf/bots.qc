// qwtf/bots.qc -- M7: one bot per team (PLAN.md M7).
//
// "One bot per team is present when the server starts; a bot leaves when a
// human joins its team if that would unbalance it. Bots move with the real
// player hull, follow map_route waypoints, fight, and run the key."
//
// HOW A BOT IS A PLAYER. FTE implements DP_SV_BOTCLIENT: spawnclient (#454)
// turns a free client slot into a client with no protocol behind it, and
// server/sv_phys.c's SV_Physics then feeds that client a usercmd built from
// the entity's own fields every server frame -- v_angle for the view,
// `.movement` (FTE's client-input vector) for forward/side/up, button0/2 for
// fire/jump -- through SV_RunCmd, the SAME path a real client's movement
// packets take. So a bot here is a real player entity in every way that the
// game can see: it takes a slot in `status`, it is a "player" classname for
// ctf.qc's auto-balance, PlayerPreThink/PlayerPostThink run for it (the team
// assignment, the probe trail, the rules), it picks up keys, takes damage,
// dies and drops what it carries.
//
// Two consequences worth writing down, both read out of the engine source
// before anything was written here:
//   * The engine's bot pre-run OVERWRITES button0/button2 from the entity's
//     own fields (SV_SetEntityButtons), and it reads them at the START of the
//     tick -- so anything this file sets lands one tick later. A held button
//     is held; a click is one frame late. Nothing in the game notices.
//   * Client entities never run .think (the physics loop `continue`s them --
//     sv_phys.c, "clients are run directly from packets"). The bot's brain
//     therefore lives in the PlayerPreThink wrap, which SV_RunCmd calls for
//     every client every tick, bots included.
//
// NAVIGATION. The routes come from qwtf/bots_nav.qc, generated by
// scripts/build_nav.py out of maps/forts.map through map_route.py -- flood
// fills on the real player hull, so a route is somewhere the engine lets a
// player walk. This file owns the machinery only: the chains of nav nodes and
// the steering, which follows the probe's proven pattern (yaw per frame,
// 48-unit arrival, jump while a waypoint is above a swimmer).
//
// The steering deliberately does NOT set fixangle the way qwtf/probe.qc does
// for test-driven clients: the engine clears fixangle on bots every tick
// (sv_phys.c: "bots never get fixangle cleared otherwise"), and there is no
// client to fight the server for the view, so v_angle alone is the bot's
// heading and it sticks.
//
// THE TWO GAME-RULE-ADJACENT THINGS HERE, both bot-only and both stated here
// rather than hidden in a helper:
//   * bots restock their own shells when they run dry -- the forts map
//     carries no ammo items, so a fighting bot would otherwise end every
//     match on the axe;
//   * bots do not drown -- the underwater passage's swim is ~10 s against a
//     12 s air clock, so a bot that fought in the middle of the passage ran
//     the clock out and drowned with the key ("Bot Blue ran out of air",
//     measured). The brain resets the vanilla air clock while the bot is wet;
//     qwtf/drown.qc exempts bots from our own 15 s clock the same way (it reads
//     qwtf_isbot from this file). A human's air is untouched.
//
// This file must never depend on qwtf/probe.qc, for the same reason ctf.qc
// must not (its header): the rules and the bots have to run on the owner's
// server, where no trace cvar is set.

#ifdef __QW__

// Forward declaration: the routes are generated into qwtf/bots_nav.qc, which
// the build appends AFTER this file, and QuakeC needs a function declared
// before its call site is compiled (ctf.qc's header says the same).
void() QWTF_nav_build;

// ---------------------------------------------------------------------------
// The bot-client builtins (DP_SV_BOTCLIENT / DP_QC_DROPCLIENT, pr_cmds.c).
// LibreQuake's defs.qc has none of them, so this is where they are declared.
entity() spawnclient = #454;
void(entity e) dropclient = #453;
void(entity e, string key, string val) forceinfokey = #213;

// FTE's client-input vector. The engine's bot pre-run builds the usercmd's
// forward/side/up from it (sv_phys.c). Not in LibreQuake's defs; the field is
// introduced here, at file scope, like every other new field in this overlay.
.vector movement;

// THE ROUTES and the module state, as PLAIN GLOBALS.
//
// They cannot live on worldspawn: FTE locks the world entity read-only
// (sv_init.c, sv_readonlyworld default 1) and every write to a world field is
// a dropped runtime warning -- the first version stored the routes on world
// fields and the log filled with "assignment to read-only entity 0". A plain
// global is a normal store; it starts at 0 (the world entity) and is
// re-zeroed when the progs reload for the next map, which is exactly the
// lifecycle this state wants.
//
// An INITIALISED global is a CONSTANT in this dialect ("assignment to
// constant", measured), which is why none of these has an initializer.
entity QWTF_nav0;                 // red:   spawn room -> blue key
entity QWTF_nav1;                 // red:   blue key -> red stand, carrying
entity QWTF_nav2;                 // red:   red stand -> blue key
entity QWTF_nav3;                 // blue:  spawn room -> red key
entity QWTF_nav4;                 // blue:  red key -> blue stand, carrying
entity QWTF_nav5;                 // blue:  blue stand -> red key
entity QWTF_nav6, QWTF_nav7, QWTF_nav8;     // red guard:  spawn->key, key->stand, stand->key
entity QWTF_nav9, QWTF_nav10, QWTF_nav11;   // blue guard: spawn->key, key->stand, stand->key

entity QWTF_navb_head;            // the chain under construction
entity QWTF_navb_tail;
float QWTF_navb_id;
float QWTF_navb_done;             // the routes are built once per map
float QWTF_bot_next;              // next housekeeping pass
float QWTF_engaged;               // set by the fight, read by the walk, within
                                  // one bot's tick (bots run sequentially)

// Per-bot state.
.float qwtf_isbot;
.entity qwtf_nav;                 // the node being walked to (world = re-pick)
.float qwtf_navroute;             // which route id qwtf_nav belongs to
.entity qwtf_chase;               // walk to this entity (a dropped key, or
                                  // the teammate carrying the enemy key)
.entity qwtf_target;              // the enemy being fought
.float qwtf_seen;                 // when the target was last visible
.float qwtf_scan;                 // throttles the enemy scan
.float qwtf_chk;                  // throttles the stuck check
.vector qwtf_chkpos;
.float qwtf_stuck;                // consecutive stuck checks

float QWTF_BOT_SPEED = 320;       // sv_maxspeed's default; holding more does
                                  // nothing, holding less walks slower
float QWTF_BOT_ARRIVE2 = 2304;    // arrival radius 48, squared, like the probe's
float QWTF_BOT_TAKE2 = 576;       // chase arrival 24: a dropped key is a
                                  // 32-unit trigger, so 48 would stop short
float QWTF_BOT_FIGHT2 = 409600;   // fight range 640, squared
float QWTF_BOT_LOST = 0.7;        // seconds a target stays aimed at unseen
float QWTF_BOT_SCAN = 0.15;       // seconds between enemy scans
float QWTF_BOT_CHECK = 1.2;       // seconds between stuck checks
float QWTF_BOT_AMMO = 25;         // the shotgun's full load
float QWTF_BOT_RESPAWN = 5;       // seconds a dead bot waits before respawning
.float qwtf_dead_at;              // when this bot died (0 = alive)

void(entity e, string what) QWTF_event_who;   // ctf.qc's, defined earlier

// ---------------------------------------------------------------------------
// The route chains.

void(float id) QWTF_route_begin =
{
    QWTF_navb_id = id;
    QWTF_navb_head = world;
    QWTF_navb_tail = world;
};

void(vector v) QWTF_node =
{
    local entity n;
    n = spawn();
    n.classname = "qwtf_navnode";
    n.solid = SOLID_NOT;
    n.movetype = MOVETYPE_NONE;
    setorigin(n, v);
    if (QWTF_navb_head == world)
    {
        QWTF_navb_head = n;
        QWTF_navb_tail = n;
    }
    else
    {
        QWTF_navb_tail.chain = n;
        QWTF_navb_tail = n;
    }
};

void(vector v) QWTF_route_end =
{
    local entity h;
    QWTF_node(v);                 // the goal is a node like the rest, so
                                  // "walk to the last node" is "walk into
                                  // the key or the stand"
    h = QWTF_navb_head;
    if (QWTF_navb_id == 0)
        QWTF_nav0 = h;
    else if (QWTF_navb_id == 1)
        QWTF_nav1 = h;
    else if (QWTF_navb_id == 2)
        QWTF_nav2 = h;
    else if (QWTF_navb_id == 3)
        QWTF_nav3 = h;
    else if (QWTF_navb_id == 4)
        QWTF_nav4 = h;
    else if (QWTF_navb_id == 5)
        QWTF_nav5 = h;
    else if (QWTF_navb_id == 6) QWTF_nav6 = h;
    else if (QWTF_navb_id == 7) QWTF_nav7 = h;
    else if (QWTF_navb_id == 8) QWTF_nav8 = h;
    else if (QWTF_navb_id == 9) QWTF_nav9 = h;
    else if (QWTF_navb_id == 10) QWTF_nav10 = h;
    else if (QWTF_navb_id == 11) QWTF_nav11 = h;
    QWTF_navb_head = world;
    QWTF_navb_tail = world;
};

entity(float id) QWTF_route_of =
{
    if (id == 0)
        return QWTF_nav0;
    if (id == 1)
        return QWTF_nav1;
    if (id == 2)
        return QWTF_nav2;
    if (id == 3)
        return QWTF_nav3;
    if (id == 4)
        return QWTF_nav4;
    if (id == 5)
        return QWTF_nav5;
    if (id == 6) return QWTF_nav6;
    if (id == 7) return QWTF_nav7;
    if (id == 8) return QWTF_nav8;
    if (id == 9) return QWTF_nav9;
    if (id == 10) return QWTF_nav10;
    if (id == 11) return QWTF_nav11;
    return world;
};

// ---------------------------------------------------------------------------
// Choosing what to do. self is a live bot.

void() QWTF_bot_pickroute =
{
    local entity key, mine, alt;
    local vector d;
    local float da, db;

    self.qwtf_chase = world;

    // DEFEND (qwtf_bot_skill 0, the default; owner, 2026-10-10: "We can leave
    // the bots as defence"). Patrol the own fort: spawn -> own key -> back to
    // spawn, forever (scripts/build_nav.py: the roof leg is not walkable yet). Walking over the own key when it lies
    // dropped returns it (ctf.qc's defender touch), so a dropped own key is
    // chased; the enemy key never is. qwtf_bot_skill 1 is the old attacker.
    if (cvar("qwtf_bot_skill") < 1)
    {
        local float base;
        local entity own;
        base = 6;
        if (self.qwtf_team == QWTF_TEAM_BLUE)
            base = 9;
        own = QWTF_key_of_team(self.qwtf_team);
        // A defender returns its own dropped key, but only on its own half:
        // chasing it into the enemy fort put both bots in one fort (owner,
        // 2026-10-10). Mid-x is halfway between the two keys' home spots.
        local entity rk, bk;
        local float midx, ownside;
        rk = QWTF_key_of_team(QWTF_TEAM_RED);
        bk = QWTF_key_of_team(QWTF_TEAM_BLUE);
        ownside = 1;
        if (own != world && rk != world && bk != world)
        {
            midx = (rk.qwtf_homevec_x + bk.qwtf_homevec_x) / 2;
            if (self.qwtf_team == QWTF_TEAM_RED)
                ownside = own.origin_x < midx;
            else
                ownside = own.origin_x > midx;
        }
        if (own != world && own.qwtf_state == QWTF_KEY_DROPPED && ownside)
        {
            self.qwtf_navroute = -1;
            self.qwtf_nav = world;
            self.qwtf_chase = own;
            return;
        }
        // Where am I? Near the own key: go up to the turn-in. Near the turn-in:
        // go down to the key. Anywhere else (a fresh spawn): spawn -> key.
        mine = QWTF_route_of(base + 1);          // starts at the key
        alt = QWTF_route_of(base + 2);           // starts at the turn-in
        d = mine.origin - self.origin;
        da = vlen(d);
        d = alt.origin - self.origin;
        db = vlen(d);
        if (mine != world && da < 160)
            self.qwtf_navroute = base + 1;
        else if (alt != world && db < 160)
            self.qwtf_navroute = base + 2;
        else
            self.qwtf_navroute = base;
        self.qwtf_nav = QWTF_route_of(self.qwtf_navroute);
        return;
    }

    if (self.qwtf_carry)
    {
        // Carrying: straight home to the capture.
        if (self.qwtf_team == QWTF_TEAM_RED)
            self.qwtf_navroute = 1;
        else
            self.qwtf_navroute = 4;
        self.qwtf_nav = QWTF_route_of(self.qwtf_navroute);
        return;
    }

    // The enemy key's state decides. HOME: take the nearer of the two out
    // routes (out_a starts at my spawn room, out_b at my own stand, so the
    // nearer one is the one that starts where I am). DROPPED or carried by a
    // teammate: walk to it -- a dropped key is picked up by touching it, and
    // a teammate who dies drops it for me.
    if (self.qwtf_team == QWTF_TEAM_RED)
    {
        key = QWTF_key_of_team(QWTF_TEAM_BLUE);
        mine = QWTF_route_of(0);
        alt = QWTF_route_of(2);
    }
    else
    {
        key = QWTF_key_of_team(QWTF_TEAM_RED);
        mine = QWTF_route_of(3);
        alt = QWTF_route_of(5);
    }

    if (key == world || key.qwtf_state == QWTF_KEY_HOME)
    {
        d = mine.origin - self.origin;
        da = d_x * d_x + d_y * d_y;
        d = alt.origin - self.origin;
        db = d_x * d_x + d_y * d_y;
        if (da <= db)
        {
            self.qwtf_navroute = 0;
            self.qwtf_nav = mine;
        }
        else
        {
            self.qwtf_navroute = 2;
            self.qwtf_nav = alt;
        }
        if (self.qwtf_team == QWTF_TEAM_BLUE)
            self.qwtf_navroute = self.qwtf_navroute + 3;
        return;
    }

    // Chase: the key is somewhere else -- dropped on the ground, or carried
    // (a carried enemy key is always in my own team's hands). qwtf_chase is
    // the KEY entity; QWTF_bot_walk resolves where to walk each tick, so a
    // carrier who moves is followed and a key that goes home re-picks.
    self.qwtf_navroute = -1;
    self.qwtf_nav = world;
    self.qwtf_chase = key;
};

// The walk. Returns 1 when it moved the bot, 0 when there is nothing to walk
// (the caller re-picks).
float() QWTF_bot_walk =
{
    local entity n, t;
    local vector d, aim;
    local float r2, f, s;

    if (self.qwtf_chase)
    {
        n = self.qwtf_chase;
        if (n.qwtf_state == QWTF_KEY_HOME)
            return 0;                 // captured or returned; re-pick
        if (n.qwtf_state == QWTF_KEY_CARRIED)
        {
            t = n.enemy;
            if (t == world)
                return 0;
        }
        else
            t = n;                    // lying on the ground where they fell

        d = t.origin - self.origin;
        r2 = d_x * d_x + d_y * d_y;
        if (r2 < QWTF_BOT_TAKE2)
        {
            self.movement = '0 0 0';
            return 1;
        }
        aim_x = d_x;
        aim_y = d_y;
        aim_z = 0;
        self.angles_y = vectoyaw(aim);
        self.v_angle_y = self.angles_y;
        // A dropped key lying on a floor below is reached by walking to it
        // and falling; a carrier swimming is followed at any depth, so climb
        // while they are above, the same rule the steering uses.
        if (self.waterlevel > 0 && t.origin_z > self.origin_z + 24)
            self.button2 = 1;
        if (QWTF_engaged)
        {
            // Shooting while moving: the route direction, expressed in the
            // aim's forward/right. v_forward/v_right are makevectors' globals.
            makevectors(self.v_angle);
            f = (d_x * v_forward_x + d_y * v_forward_y) * QWTF_BOT_SPEED;
            s = (d_x * v_right_x + d_y * v_right_y) * QWTF_BOT_SPEED;
            self.movement_x = f;
            self.movement_y = s;
            self.movement_z = 0;
        }
        else
        {
            self.movement = '0 0 0';
            self.movement_x = QWTF_BOT_SPEED;
        }
        return 1;
    }

    n = self.qwtf_nav;
    if (n == world)
        return 0;

    d_x = n.origin_x - self.origin_x;
    d_y = n.origin_y - self.origin_y;
    d_z = 0;
    if (d_x * d_x + d_y * d_y < QWTF_BOT_ARRIVE2)
    {
        n = n.chain;
        if (n == world)
        {
            // Route done. Either the objective fired its touch (the take or
            // the capture) or it did not; either way the next tick re-picks
            // from where I am standing now.
            self.qwtf_nav = world;
            self.movement = '0 0 0';
            return 0;
        }
        self.qwtf_nav = n;
        d_x = n.origin_x - self.origin_x;
        d_y = n.origin_y - self.origin_y;
    }

    aim_x = d_x;
    aim_y = d_y;
    aim_z = 0;
    if (QWTF_engaged)
    {
        // Shooting while moving: keep the aim on the enemy and walk the
        // route anyway, by expressing the route direction in the aim's
        // forward/right (v_forward/v_right are makevectors' globals).
        makevectors(self.v_angle);
        f = (d_x * v_forward_x + d_y * v_forward_y) * QWTF_BOT_SPEED;
        s = (d_x * v_right_x + d_y * v_right_y) * QWTF_BOT_SPEED;
        self.movement_x = f;
        self.movement_y = s;
        self.movement_z = 0;
    }
    else
    {
        self.angles_y = vectoyaw(aim);
        self.v_angle_y = self.angles_y;
        self.movement = '0 0 0';
        self.movement_x = QWTF_BOT_SPEED;
    }

    // The probe's surfacing rule: a yaw cannot swim upwards, so hold jump
    // while the node is meaningfully above a swimmer.
    if (self.waterlevel > 0 && n.origin_z > self.origin_z + 24)
        self.button2 = 1;
    return 1;
};

// Fight: find the nearest visible enemy, aim, hold fire. The bot does NOT
// stop to brawl: the first run measured two bots meeting on the bridge,
// stopping, and killing each other on the same spot for the whole smoke
// while neither ever reached a vault. So the fight only aims and presses
// fire; the walk keeps walking (toward the route's node, decomposed into the
// aim's forward/right), which is how a player crosses a bridge under fire.
// Returns 1 while engaged.
float() QWTF_bot_fight =
{
    local entity e, best;
    local vector d, aim;
    local float best2, dd;

    QWTF_engaged = 0;

    if (time >= self.qwtf_scan)
    {
        self.qwtf_scan = time + QWTF_BOT_SCAN;
        best = world;
        best2 = QWTF_BOT_FIGHT2;
        e = find(world, classname, "player");
        while (e)
        {
            // An ENEMY: on a team (a lobby waiter has team 0 and no body, and
            // was shot at and "followed" -- owner, 2026-10-10), not ours, and
            // able to take damage.
            if (e != self && e.health > 0 && e.deadflag == DEAD_NO
                && e.qwtf_team != 0 && e.qwtf_team != self.qwtf_team
                && e.takedamage != DAMAGE_NO)
            {
                d = e.origin - self.origin;
                dd = d_x * d_x + d_y * d_y;
                if (dd < best2)
                {
                    traceline(self.origin + self.view_ofs,
                              e.origin + '0 0 16', FALSE, self);
                    if (trace_fraction == 1.0 || trace_ent == e)
                    {
                        best2 = dd;
                        best = e;
                    }
                }
            }
            e = find(e, classname, "player");
        }
        if (best)
        {
            self.qwtf_target = best;
            self.qwtf_seen = time;
        }
    }

    if (self.qwtf_target == world)
        return 0;

    if (self.qwtf_target.health <= 0 || self.qwtf_target.deadflag != DEAD_NO)
    {
        self.qwtf_target = world;
        return 0;
    }

    d = self.qwtf_target.origin - self.origin;
    if (d_x * d_x + d_y * d_y > QWTF_BOT_FIGHT2)
    {
        self.qwtf_target = world;
        return 0;
    }

    // Still there? A wall between us ends the engagement after LOST seconds.
    traceline(self.origin + self.view_ofs,
              self.qwtf_target.origin + '0 0 16', FALSE, self);
    if (trace_fraction == 1.0 || trace_ent == self.qwtf_target)
        self.qwtf_seen = time;
    if (time > self.qwtf_seen + QWTF_BOT_LOST)
    {
        self.qwtf_target = world;
        return 0;
    }

    // Aim at the enemy -- but a target nearly straight up or down (the two
    // bots one above the other in the passage) has no horizontal direction:
    // the yaw would flip sign every frame and the decomposed walk would
    // shake on the spot (measured: both bots froze at x=1712 for the whole
    // tail of a run, each 200 units above the other, shooting past each
    // other). So the yaw only updates while there IS a horizontal
    // direction, and the pitch is clamped to +/-45 degrees.
    aim = (self.qwtf_target.origin + '0 0 16') - (self.origin + self.view_ofs);
    aim_z = 0;
    if (aim_x * aim_x + aim_y * aim_y > 2500)
    {
        self.angles_y = vectoyaw(aim);
        self.v_angle_y = self.angles_y;
    }
    aim = (self.qwtf_target.origin + '0 0 16') - (self.origin + self.view_ofs);
    aim = vectoangles(aim);
    if (aim_x > 45)
        aim_x = 45;
    if (aim_x < -45)
        aim_x = -45;
    self.v_angle_x = aim_x;
    self.button0 = 1;
    QWTF_engaged = 1;
    return 1;
};

// Put the bot back in its own fort's spawn room: after a spawn (the vanilla
// SelectSpawnPoint does not know about sides) and when the stuck counter
// gives up. Prefers an unoccupied spot on its own side, the vanilla way.
void() QWTF_bot_place =
{
    local entity spot, best, thing;
    local entity rk, bk;
    local float mid, occupied, want_x_lo, want_x_hi;
    local float found;

    rk = QWTF_key_of_team(QWTF_TEAM_RED);
    bk = QWTF_key_of_team(QWTF_TEAM_BLUE);
    if (rk == world || bk == world)
        return;                       // not a CTF map; leave the spawn alone
    // The keys' HOME spots, not where they are now: a taken key is hidden at
    // the world origin (x 0), which moved "mid" into the red base and spawned
    // the blue bot there (owner playtest 2026-10-10).
    mid = (rk.qwtf_homevec_x + bk.qwtf_homevec_x) * 0.5;

    found = 0;
    best = world;
    spot = find(world, classname, "info_player_deathmatch");
    while (spot && !found)
    {
        if (self.qwtf_team == QWTF_TEAM_RED)
        {
            want_x_lo = 0;
            want_x_hi = mid;
        }
        else
        {
            want_x_lo = mid;
            want_x_hi = 1000000;
        }
        if (spot.origin_x >= want_x_lo && spot.origin_x <= want_x_hi)
        {
            occupied = 0;
            thing = findradius(spot.origin, 84);
            while (thing && !occupied)
            {
                if (thing != self && thing.classname == "player")
                    occupied = 1;
                else
                    thing = thing.chain;
            }
            if (!occupied)
            {
                best = spot;
                found = 1;
            }
        }
        spot = find(spot, classname, "info_player_deathmatch");
    }

    if (best)
    {
        setorigin(self, best.origin);
        self.velocity = '0 0 0';
    }
    self.qwtf_nav = world;
    self.qwtf_chase = world;
    self.qwtf_target = world;
};

// The brain, run from the PlayerPreThink wrap with self = the bot.
void() QWTF_bot_brain =
{
    local vector d;

    if (self.deadflag != DEAD_NO)
    {
        // QW respawns on a button once the corpse is READY; the wait between
        // DEAD and READY wants the button UP, so release during DEAD and
        // click at RESPAWNABLE. The 10 s anti-stall would respawn anyway.
        // Owner, 2026-10-10: "they spawn too fast". Wait QWTF_BOT_RESPAWN s.
        self.movement = '0 0 0';
        if (!self.qwtf_dead_at)
            self.qwtf_dead_at = time;
        if (self.deadflag == DEAD_RESPAWNABLE && time >= self.qwtf_dead_at + QWTF_BOT_RESPAWN)
            self.button0 = 1;
        else
            self.button0 = 0;
        self.button2 = 0;
        return;
    }
    self.qwtf_dead_at = 0;

    // The bots' aim and restock are written for the hitscan super shotgun.
    // Every class now spawns on its signature weapon (a Soldier on rockets),
    // and a bot firing rockets at close range blew itself up (owner,
    // 2026-10-10: "they shoot at their feet and die"). Checked every frame,
    // because the class apply runs after the bot's own spawn hook.
    if (self.weapon != IT_SUPER_SHOTGUN && (self.items & IT_SUPER_SHOTGUN))
    {
        self.weapon = IT_SUPER_SHOTGUN;
        W_SetCurrentAmmo();
    }

    self.button0 = 0;
    self.button2 = 0;

    // Bots restock their own shells (see the header).
    if (self.ammo_shells < 5)
        self.ammo_shells = QWTF_BOT_AMMO;

    // Bots do not drown (see the header): reset the vanilla air clock while
    // they are wet. Our own 15 s clock is exempted in qwtf/drown.qc, which reads
    // qwtf_isbot from here -- the exemption lives with the rule, because the rule
    // owns the fields it has to clear.
    if (self.waterlevel > 0)
        self.air_finished = time + 12;

    if (QWTF_bot_fight())
    {
        // A fight is not stuck: holding position and shooting is exactly
        // what the stuck check would otherwise count as wedged (measured:
        // a bot that won a duel at (1632, 607) was then teleported home by
        // its own stuck counter for standing still 3.6 s). Reset the
        // baseline so the check restarts after the brawl.
        self.qwtf_stuck = 0;
        self.qwtf_chk = time + QWTF_BOT_CHECK;
        self.qwtf_chkpos = self.origin;
        return;
    }

    // Stuck check: nothing for a second and a half means wedged; skipping the
    // node is the cheap fix, and three in a row means teleport home.
    if (time >= self.qwtf_chk)
    {
        if (self.qwtf_chk)
        {
            d = self.origin - self.qwtf_chkpos;
            if (d_x * d_x + d_y * d_y < 12 * 12)
            {
                self.qwtf_stuck = self.qwtf_stuck + 1;
                if (self.qwtf_nav && self.qwtf_nav.chain != world)
                    self.qwtf_nav = self.qwtf_nav.chain;
                if (self.qwtf_stuck >= 3)
                {
                    self.qwtf_stuck = 0;
                    QWTF_bot_place();
                    return;
                }
            }
            else
                self.qwtf_stuck = 0;
        }
        self.qwtf_chk = time + QWTF_BOT_CHECK;
        self.qwtf_chkpos = self.origin;
    }

    if (self.qwtf_nav == world && self.qwtf_chase == world)
        QWTF_bot_pickroute();

    QWTF_bot_walk();
};

// The kick messages are MSG_ONE writes aimed at the shooter (weapons.qc
// SmallKick/BigKick). A bot client has no protocol behind it, so FTE refuses
// every such write and prints a line each time (net_preparse.c, via
// Write_GetClient's bot rule) -- measured, that was several lines of
// "msg_entity: not a client" per second in a duel. The punch angle is
// cosmetic and client-side anyway, so the overlay drops it for bots only;
// a human's kicks are untouched.
wrap void() SmallKick =
{
    if (!self.qwtf_isbot)
        prior();
};

wrap void() BigKick =
{
    if (!self.qwtf_isbot)
        prior();
};

// ---------------------------------------------------------------------------
// Spawning, balance and the per-frame hooks.

void(float team) QWTF_bot_spawn =
{
    local entity b;
    local entity was;

    b = spawnclient();
    if (b == world)
        return;                       // no free slot (maxclients full)

    b.qwtf_isbot = 1;
    b.qwtf_team = team;
    if (team == QWTF_TEAM_RED)
    {
        forceinfokey(b, "name", "Bot Red");
        forceinfokey(b, "team", "red");
        forceinfokey(b, "topcolor", "4");
        forceinfokey(b, "bottomcolor", "4");
    }
    else
    {
        forceinfokey(b, "name", "Bot Blue");
        forceinfokey(b, "team", "blue");
        forceinfokey(b, "topcolor", "13");
        forceinfokey(b, "bottomcolor", "13");
    }

    was = self;
    self = b;
    ClientConnect();
    PutClientInServer();              // the wrap below puts the bot in its
                                      // own fort's spawn room
    self = was;

    QWTF_event_who(b, "bot_join");
};

// One pass per second: the leave rule and the top-up.
//
//   leave   "a bot leaves when a human joins its team if that would
//           unbalance it" -- if the teams are more than 1 apart with everyone
//           counted, a bot leaves the larger one. Never a human.
//   top-up  "one bot per team ... when the server starts" -- a team with no
//           bot gets one while the result stays within the same 1-difference
//           rule. On an empty server that is exactly one bot per side.
void() QWTF_bot_housekeeping =
{
    local entity e;
    local float rh, bh, rb, bb, diff;

    rh = 0; bh = 0; rb = 0; bb = 0;
    e = find(world, classname, "player");
    while (e)
    {
        if (e.qwtf_team == QWTF_TEAM_RED)
        {
            if (e.qwtf_isbot)
                rb = rb + 1;
            else
                rh = rh + 1;
        }
        else if (e.qwtf_team == QWTF_TEAM_BLUE)
        {
            if (e.qwtf_isbot)
                bb = bb + 1;
            else
                bh = bh + 1;
        }
        e = find(e, classname, "player");
    }

    // leave
    diff = (rh + rb) - (bh + bb);
    if (diff > 1)
    {
        e = find(world, classname, "player");
        while (e)
        {
            if (e.qwtf_isbot && e.qwtf_team == QWTF_TEAM_RED)
            {
                QWTF_event_who(e, "bot_leave");
                dropclient(e);
                return;               // one per pass; the next pass sees the
                                      // new counts
            }
            e = find(e, classname, "player");
        }
    }
    else if (diff < -1)
    {
        e = find(world, classname, "player");
        while (e)
        {
            if (e.qwtf_isbot && e.qwtf_team == QWTF_TEAM_BLUE)
            {
                QWTF_event_who(e, "bot_leave");
                dropclient(e);
                return;
            }
            e = find(e, classname, "player");
        }
    }

    // top-up
    if (rb == 0 && diff + 1 <= 1)
    {
        QWTF_bot_spawn(QWTF_TEAM_RED);
        rb = 1;
        diff = diff + 1;
    }
    if (bb == 0 && diff - 1 >= -1)
        QWTF_bot_spawn(QWTF_TEAM_BLUE);
};

// The spawn room: the vanilla SelectSpawnPoint does not know about sides, so
// the wrap re-places every bot the moment it is spawned -- on the first spawn
// and on every death respawn alike.
wrap void() PutClientInServer =
{
    prior();
    if (self.qwtf_isbot)
    {
        QWTF_bot_place();
    }
};

wrap void() PlayerPreThink =
{
    prior();                          // ctf.qc's team handling, probe.qc's
                                      // steering, then the original
    if (self.qwtf_isbot)
        QWTF_bot_brain();
};

wrap void() StartFrame =
{
    prior();                          // world.qc's own StartFrame first: it is
                                      // what reads the deathmatch cvar into
                                      // the progs global, and a bot spawned
                                      // before that ran spawned at the world
                                      // origin and telefragged (measured)
    if (!QWTF_navb_done)
    {
        QWTF_navb_done = 1;
        QWTF_nav_build();
        // And the first bot waits two seconds anyway: spawning into frame
        // one of a map that is still settling is what produced that first
        // telefrag, and the owner's server gains nothing by racing it.
        QWTF_bot_next = time + 2;
    }
    if (cvar("qwtf_bots") >= 1 && time >= QWTF_bot_next)
    {
        QWTF_bot_next = time + 1;
        QWTF_bot_housekeeping();
    }
};

#else

// The deathmatch build has no game rules and no bots; this compiles to
// nothing rather than not compiling (probe.qc's pattern).
void() QWTF_bots_unavailable =
{
    dprint("QWTF bots need the QW progs (qwprogs.dat)\n");
};

#endif
